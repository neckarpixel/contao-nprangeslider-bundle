{
   "name":"neckarpixel/contao-nprangeslider-bundle",
   "type":"contao-bundle",
   "description":"Standalone Contao 5 backend widget: range slider with live value display and labeled scale (inputType 'rangeSlider').",
   "license":"LGPL-3.0-or-later",
   "homepage":"https://github.com/neckarpixel/contao-nprangeslider-bundle",
   "support":{
      "issues":"https://github.com/neckarpixel/contao-nprangeslider-bundle/issues",
      "source":"https://github.com/neckarpixel/contao-nprangeslider-bundle"
   },
   "authors":[
      {
         "name":"Neckarpixel",
         "homepage":"https://www.neckarpixel.de"
      }
   ],
   "minimum-stability":"stable",
   "require":{
      "php":"^8.1",
      "contao/core-bundle":"^5.0"
   },
   "conflict":{
      "contao/core":"*",
      "contao/manager-plugin":"<2.0 || >=3.0"
   },
   "require-dev":{
      "contao/manager-plugin":"^2.0",
      "friendsofphp/php-cs-fixer":"^3.0",
      "phpunit/phpunit":"^9.5",
      "symfony/phpunit-bridge":"^5.4 || ^6.0"
   },
   "autoload":{
      "psr-4":{
         "Np\\RangesliderBundle\\":"src/"
      }
   },
   "autoload-dev":{
      "psr-4":{
         "Np\\RangesliderBundle\\Tests\\":"tests/"
      }
   },
   "extra":{
      "contao-manager-plugin":"Np\\RangesliderBundle\\ContaoManager\\Plugin"
   }
}
